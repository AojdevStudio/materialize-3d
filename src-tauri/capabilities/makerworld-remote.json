{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "makerworld-remote",
  "description": "The remote MakerWorld webview may only report the page it shows and the result of an import. It cannot call any other app command.",
  "local": false,
  "webviews": [
    "makerworld"
  ],
  "remote": {
    "urls": [
      "https://makerworld.com/*",
      "https://*.makerworld.com/*"
    ]
  },
  "permissions": [
    "core:default",
    "allow-report-makerworld-page",
    "allow-report-makerworld-import-attempt"
  ]
}
