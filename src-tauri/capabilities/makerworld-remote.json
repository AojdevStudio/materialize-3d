{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "makerworld-remote",
  "description": "Allow the embedded MakerWorld child webview to report extracted page metadata back through the Tauri IPC bridge.",
  "local": false,
  "webviews": ["makerworld"],
  "remote": {
    "urls": [
      "https://makerworld.com/*",
      "https://*.makerworld.com/*"
    ]
  },
  "permissions": [
    "core:default"
  ]
}
