{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the local main application webview",
  "webviews": [
    "main"
  ],
  "permissions": [
    "core:default",
    "log:default",
    "opener:default",
    "dialog:default",
    "allow-update-check",
    "allow-update-install",
    "allow-studio-files",
    "allow-studio-import-file",
    "allow-studio-save-bytes",
    "allow-studio-reveal",
    "allow-studio-open-in-bambu",
    "allow-studio-pop-out",
    "allow-studio-file-version",
    "allow-studio-slicer",
    "allow-studio-flush-started",
    "allow-studio-flush-failed",
    "allow-studio-flushed",
    "allow-studio-open-files-privacy",
    "allow-bambu-last-used",
    "allow-studio-printers",
    "allow-sidecar"
  ]
}
