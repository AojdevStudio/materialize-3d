{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the local main application webview",
  "webviews": [
    "main"
  ],
  "permissions": [
    "core:default",
    "log:default",
    "opener:default",
    "notification:default",
    "dialog:default",
    "allow-get-app-state",
    "allow-set-active-view",
    "allow-sync-makerworld-webview",
    "allow-navigate-makerworld",
    "allow-search-makerworld",
    "allow-makerworld-back",
    "allow-makerworld-forward",
    "allow-makerworld-reload",
    "allow-download-model",
    "allow-report-makerworld-page",
    "allow-report-makerworld-import-attempt",
    "allow-connect-printer",
    "allow-disconnect-printer",
    "allow-get-printer-status",
    "allow-probe-camera",
    "allow-pause-print",
    "allow-resume-print",
    "allow-start-print",
    "allow-list-profiles",
    "allow-slice-model",
    "allow-read-model-file",
    "allow-read-text-file",
    "allow-write-text-file",
    "allow-add-to-queue",
    "allow-get-queue",
    "allow-remove-from-queue",
    "allow-get-print-history",
    "allow-delete-print-history-item",
    "allow-get-library-models",
    "allow-search-library-models",
    "allow-delete-library-model",
    "allow-open-library-model",
    "allow-openscad-check-installed",
    "allow-openscad-extract-params",
    "allow-openscad-render",
    "allow-get-designs-dir",
    "allow-store-credential",
    "allow-get-credential",
    "allow-delete-credential",
    "allow-has-credential",
    "allow-start-oauth-callback",
    "allow-stop-oauth-callback",
    "allow-oauth-token-exchange",
    "allow-add-printer-config",
    "allow-update-printer-config",
    "allow-delete-printer-config",
    "allow-get-printer-configs",
    "allow-set-default-printer",
    "allow-connect-printer-by-config",
    "allow-switch-printer",
    "allow-get-settings",
    "allow-update-settings"
  ]
}
