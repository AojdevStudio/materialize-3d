{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Materialize 3D",
  "version": "0.2.1",
  "identifier": "com.aojdevstudio.materialize3d",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Materialize 3D",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 768,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/Assets.car"
    ],
    "category": "GraphicsAndDesign",
    "copyright": "Copyright (c) 2026 Ossie Irondi",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "resources/bambu/AGPL-3.0.txt": "AGPL-3.0.txt"
    },
    "macOS": {
      "minimumSystemVersion": "26.0",
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhEQjg3ODAwNzNEQjU0QUIKUldTclZOdHpBSGk0amR2OWF4c3ZlUUFTVHV1MTJsRFpDVVhvL0UxYkhyQjRLUy9kc3NHMkNvZ28K",
      "endpoints": [
        "https://github.com/AojdevStudio/materialize-3d/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
