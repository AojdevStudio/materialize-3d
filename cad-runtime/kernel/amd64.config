# Guest kernel for the CAD worker's Linux test backend (amd64), applied on top of `allnoconfig`.
# The same job surface as arm64.config on the devices a KVM microVM provides (Firecracker, or QEMU's microvm machine
# with ACPI off): virtio-mmio devices announced on the kernel command line (block, vsock, entropy), an 8250 serial
# console, MP tables for the CPUs, and a PVH entry point so the uncompressed vmlinux boots without a boot loader.
# Deliberately absent, as on arm64: loadable modules, every network device driver, virtio-fs, 9p, FUSE, and network
# filesystems, so the guest has no driver for a network card or a host file share even if one were attached.
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=8
CONFIG_X86_MPPARSE=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_PVH=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_FILE_LOCKING=y
CONFIG_POSIX_TIMERS=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_MODULES=n
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=n
CONFIG_SECCOMP=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_VIRTIO_BLK=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=n
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_NETDEVICES=n
CONFIG_WIRELESS=n
CONFIG_VIRTIO_FS=n
CONFIG_FUSE_FS=n
CONFIG_NET_9P=n
CONFIG_NETWORK_FILESYSTEMS=n
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_MISC_FILESYSTEMS=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EXT4_FS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_PSI=n
CONFIG_KALLSYMS=y
