# Kernel source pin. The sha256 is kernel.org's published sum for the tarball.
KERNEL_VERSION=6.18.54
KERNEL_SHA256=9df30b02dd8102bbd0be52556288ef6889ddbe7f1ddb96fbf847d0becf3eacac
KERNEL_URL=https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-6.18.54.tar.xz
# kernel.org's signature over the uncompressed tar, and the key that must have made it: Greg Kroah-Hartman's, whose
# fingerprint https://www.kernel.org/signature.html lists. kernel-signing-keys.asc is that key, fetched over WKD
# (`gpg --locate-keys gregkh@kernel.org`) and exported with export-minimal. A stable release signed by another
# kernel.org developer needs that developer's key added there and named here.
KERNEL_SIGN_URL=https://cdn.kernel.org/pub/linux/kernel/v6.x/linux-6.18.54.tar.sign
KERNEL_SIGNER=647F28654894E3BD457199BE38DBBDC86092693E
# Cross toolchain image for the kernel and the filesystem tools (index digest).
TOOLS_BASE=debian:trixie-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a
