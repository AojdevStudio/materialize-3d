{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Materialize 3D",
  "version": "../package.json",
  "identifier": "com.aojdevstudio.materialize3d.mobile",
  "build": {
    "beforeBuildCommand": "bun run build:mobile",
    "frontendDist": "../dist-mobile"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Materialize 3D" }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost m3dremote: data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["../src-tauri/icons/32x32.png", "../src-tauri/icons/128x128.png", "../src-tauri/icons/128x128@2x.png", "../src-tauri/icons/icon.icns", "../src-tauri/icons/icon.png"],
    "iOS": { "minimumSystemVersion": "18.0" }
  }
}
